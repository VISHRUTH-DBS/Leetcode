import java.util.Arrays;

class Solution { 
    public int findTheDistanceValue(int[] arr1, int[] arr2, int d) { 
        Arrays.sort(arr1); 
        Arrays.sort(arr2); 
        int n = arr1.length; 
        int m = arr2.length; 
        int c = 0; 
        
        for(int i=0; i<n; i++){ 
            boolean a = true; 
            int l = 0; 
            int r = m - 1; 
            
            while(l <= r){ 
                int mid = l + (r - l) / 2; 
                
                if(Math.abs(arr1[i] - arr2[mid]) <= d){ 
                    a = false; 
                    break; 
                } 
                
                if(arr2[mid] < arr1[i]) {
                    l = mid + 1;
                } else {
                    r = mid - 1;
                }
            } 
            if(a == true) c++; 
        } 
        return c; 
    } 
}
