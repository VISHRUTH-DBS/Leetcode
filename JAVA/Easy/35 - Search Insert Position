class Solution {
    public int searchInsert(int[] nums, int target) {
        int n = nums.length;

        int[] arr = new int[n + 1];

        for (int i = 0; i < n; i++) {
            arr[i] = nums[i];
        }

        arr[n] = target;

        Arrays.sort(arr);

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == target) {
                return i;
            }
        }

        return -1;
    }
}
