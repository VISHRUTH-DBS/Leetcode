class Solution {
    public int[] leftRightDifference(int[] nums) {
        int n=nums.length;
        int arr[] =new int[n];
        for(int i=0;i<n;i++){
            int rs=0,ls=0;
            for(int j=i+1;j<n;j++){
                rs=rs+nums[j];
            }
            for(int k=0;k<i ;k++ ){
                ls=ls+nums[k];
            }

            arr[i]=Math.abs(rs-ls);

        }

        return arr;
    }
}
