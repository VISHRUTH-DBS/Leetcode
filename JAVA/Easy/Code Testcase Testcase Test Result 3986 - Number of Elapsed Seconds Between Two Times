class Solution {
    public int secondsBetweenTimes(String startTime, String endTime) {
        String p1[] = startTime.split(":");
        String p2[] = endTime.split(":");
        int h1 = Integer.parseInt(p1[0]);  
        int m1 = Integer.parseInt(p1[1]);
        int s1 = Integer.parseInt(p1[2]);
        int h2 = Integer.parseInt(p2[0]);
        int m2 = Integer.parseInt(p2[1]);
        int s2 = Integer.parseInt(p2[2]); 
        int a = s1 + (m1*60) + (h1*3600);  
        int b = s2 + (m2*60) + (h2*3600);
        return b-a; 
    }
}
