class Solution {
    public int removeDuplicates(int[] nums) {
        int n= nums.length;
        for(int i=1;i<=n-1;i++){
            if(nums[i]==nums[i-1]){
                nums[i-1]=nums[n-1];
                n--;
                Arrays.sort(nums);
                i--;
            }
            
        }
        return n;        
    }
}
