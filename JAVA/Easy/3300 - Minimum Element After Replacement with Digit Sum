class Solution {
    public int minElement(int[] nums) {
        int arr[]=new int[nums.length];
        for(int i=0;i<nums.length;i++){
            int s=0;
            while(nums[i]>0){
                int rem=nums[i]%10;
                s=s+rem;
                nums[i]=nums[i]/10;

            }       
            arr[i]=s;
        }       
        Arrays.sort(arr);
        return(arr[0]);
    }
}
