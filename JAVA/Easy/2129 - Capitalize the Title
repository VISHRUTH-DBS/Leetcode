class Solution {
    public String capitalizeTitle(String title) {
        title = title.toLowerCase();
        String[] arr = title.split(" ");
        for(int i=0;i<arr.length;i++){
            if(arr[i].length()>2){
                arr[i] = Character.toUpperCase(arr[i].charAt(0)) + arr[i].substring(1);
            }
        }
        title = String.join(" ",arr);
        return title;

    }
}
