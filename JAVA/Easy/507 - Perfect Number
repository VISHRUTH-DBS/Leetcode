class Solution {
    public boolean checkPerfectNumber(int num) {
        
        int sum=0;
        boolean a=false;
        
            for(int i=1;i<=num/2;i++){
                if(num%i==0){
                    sum=sum+i;
                }
            }
            
        if(sum==num){
            a=true;
        }

        return a;
            
        
        
    }
}
