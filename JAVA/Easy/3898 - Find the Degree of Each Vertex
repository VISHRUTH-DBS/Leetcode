class Solution {
    public int[] findDegrees(int[][] matrix) {
        int n = matrix[0].length;
        int m = matrix.length;
        int arr[] = new int[n];

        for(int i=0;i<n;i++){
            arr[i]=0;
            for(int j=0;j<m;j++){
                arr[i]=arr[i]+matrix[i][j];
            }
        }        
        return arr;
    }
}
