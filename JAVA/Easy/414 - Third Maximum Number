class Solution {
    public int thirdMax(int[] nums) {
        Arrays.sort(nums);

        int n = nums.length;
        int max = nums[n - 1];
        int second = max;
        int third = max;


        for (int i = n - 2; i >= 0; i--) {
            if (nums[i] != max) {
                second = nums[i];
                break;
            }
        }

        for (int i = n - 2; i >= 0; i--) {
            if (nums[i] != max && nums[i] != second) {
                third = nums[i];
                break;
            }
        }

        if (third == max) {
            return max;
        }

        return third;
    }
}
