import java.util.Arrays;

class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        int n = grid[0].length;
        int m = grid.length;
        int arr[]  = new int[n*m]; 
        int brr[]  = new int[2];
        int k = 0;
        for(int i = 0; i<n;i++){
            for(int j=0;j<m;j++){
                arr[k] = grid[i][j];
                k++;
            }
        }        
        Arrays.sort(arr);
        n = arr.length;
        
        int j=1;
        for(int i=0;i<n;i++){
            if(arr[i]==j){
                j++;
            }
            else if(i > 0 && arr[i] < j && arr[i-1] != arr[i]){
                brr[1] = j;
                j += 2;
            }
            else if(i > 0 && arr[i] < j && arr[i-1] == arr[i]){
                brr[0] = arr[i];
            }
            else if(i > 0 && arr[i] > j && arr[i-1] != arr[i]){
                brr[1] = j;
                j += 2;
            }
            else if(i > 0 && arr[i-1] == arr[i]){ 
                brr[0] = arr[i];
            }
            else if(i == 0 && arr[i] > j) {
                brr[1] = j;
                j++;       
                i--;        
            }
        }
        

        if(brr[1] == 0) {
            brr[1] = n;
        }
        
        return brr;
    }
}
